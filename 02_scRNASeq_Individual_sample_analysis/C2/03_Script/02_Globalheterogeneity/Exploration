# open the seurat object
sc10x = readRDS(file.path( PATH_ANALYSIS_OUTPUT, paste0( outputFilesPrefix, "seuratObject_final.RDS")))


## remove line breaks

# Remove accidental line breaks in cluster names
sc10x$cluster_renames <- gsub("\n", " ", sc10x$cluster_renames)
