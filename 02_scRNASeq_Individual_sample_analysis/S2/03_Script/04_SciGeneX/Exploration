########## Plot selected top genes in a selected module on UMAP (from sc10x object)

umap_one_module <-function(module_nb){
  # Construct the module column name in meta.data
  module_col <- paste0("Module_", module_nb)

  # Plot module score on UMAP
  p_module <- FeaturePlot(
    sc10x, 
    features = module_col, 
    reduction = "umap", 
    cols = viridisLite::viridis(100)
  ) + 
    theme(text = element_text(size = 10)) + 
    NoLegend() + 
    NoAxes()
  
  return(p_module)
}
















 
