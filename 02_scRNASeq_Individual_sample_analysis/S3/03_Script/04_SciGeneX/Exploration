########## Plot selected top genes in a selected module on UMAP 

umap_one_module_topGenes <-function(module_nb, gene_nb){
  # Select a module
  gene_in_module <- cluster_feature_combine[[module_nb]]

  # Select the number of top genes to plot in this module
  selection_gene_in_module <- gene_in_module[1:gene_nb]
  p_gene_module <-FeaturePlot_scCustom(sc10x, features =selection_gene_in_module, reduction  =  "umap", colors_use = viridis_light_high)& 
  theme(text = element_text(size = 10))

  for(i in 1:length(selection_gene_in_module)) {
    p_gene_module[[i]] <- p_gene_module[[i]] + NoLegend() + NoAxes()
  }
  p_gene_module
}

########## Plotting a specific module individually on UMAP

umap_one_module <- function(module_nb){
  module_name_list = Module_name
  module_name = module_name_list[module_nb]
  p <-FeaturePlot_scCustom(sc10x, features = module_name, reduction  =  "umap", colors_use = viridis_light_high,pt.size = 0.05) & 
  theme(text = element_text(size = 10))

  p[module_name] <- p[module_name] + NoLegend() + NoAxes()

  module_nb_umap <- p+plot_layout(ncol = 1)
  module_nb_umap
}

