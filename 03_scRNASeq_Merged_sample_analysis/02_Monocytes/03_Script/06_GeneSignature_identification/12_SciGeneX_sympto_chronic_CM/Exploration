  p_heatmap <- plot_ggheatmap(res_subset_SciGeneX_chronic[module_nb,], ident = Seurat::Idents(sc10x_subset_chronic_sgx), use_top_genes = T) + ggtitle("All clusters (top genes)") +  theme(strip.text.y = element_text(size=4))
  # save plot
  ggsave(plot = p_heatmap, filename = file.path(PATH_ANALYSIS_OUTPUT, paste0("meaningful_modules_", outputFilesPrefix,SCIGENEX_METHOD,"_inflation_",SCIGENEX_INFLATION,"_heatmap_after_SciGeneX_chronic.png"))
       , width = 23, height = 13, units ="cm")

  plot_heatmap(res_subset_SciGeneX_chronic[module_nb,],use_top_genes = T, cell_clusters =Seurat::Idents(sc10x_subset_chronic_sgx)) #becarful heatmap interactive 
}
